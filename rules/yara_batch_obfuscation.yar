rule BatCloak_Obfuscated_Batch {
    meta:
        description = "Detects batch files packed or obfuscated using BatCloak/ScrubCrypt patterns"
        author = "Cyber Security & Reverse Engineering Lab"
        date = "2026-10-11"
        reference = "Unit 42 BatCloak Research"
        threat_level = "High"
    strings:
        $cert_marker = "-----BEGIN " ascii wide
        $crl_marker = "CRL-----" ascii wide
        $certutil = "certutil" ascii wide nocase
        $decode = "-decode" ascii wide nocase
        $findstr = "findstr" ascii wide nocase
        $set_rnd = /set\s+[a-zA-Z0-9_]{4,12}=[^\r\n]{1,3}/ ascii wide
    condition:
        ($cert_marker and $certutil and $decode) or
        ($findstr and $certutil and #set_rnd > 15)
}

rule Somalifuscator_Pattern {
    meta:
        description = "Detects batch scripts generated by SomalifuscatorV2"
        author = "Cyber Security & Reverse Engineering Lab"
        date = "2026-10-11"
        reference = "KingKDot SomalifuscatorV2"
        threat_level = "Medium"
    strings:
        $anti_changes = "AntiChanges" ascii wide nocase
        $scramble = "%TO_SCRAMBLE_PLZ%" ascii wide nocase
        $caesar = /set\s+[A-Za-z0-9_]{5,}\=[A-Za-z0-9_]/ ascii wide
        $cls = "@cls" ascii wide nocase
    condition:
        $scramble or
        ($cls and #caesar > 20 and $anti_changes)
}

rule Generic_High_Entropy_Batch_Obfuscation {
    meta:
        description = "Detects generic high-density variable slicing and caret evasion in batch files"
        author = "Cyber Security & Reverse Engineering Lab"
        date = "2026-10-11"
        threat_level = "Medium"
    strings:
        $caret_cluster = /(\^[A-Za-z0-9_\-\.\:\/]){4,}/ ascii wide
        $slice_cluster = /(%[A-Za-z0-9_]{1,10}:~-?[0-9]+,-?[0-9]+%){3,}/ ascii wide
        $var_cluster = /(%[A-Za-z0-9_]{1,4}%){6,}/ ascii wide
    condition:
        #caret_cluster > 3 or
        #slice_cluster > 3 or
        #var_cluster > 5
}
